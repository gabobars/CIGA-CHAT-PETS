    "color";

  return pet;
}


/* =========================================================
   FRAME RENDER
   ========================================================= */

function renderFrame(
  pet
) {
  if (
    !pet.sequence.length
  ) {
    return;
  }

  const src =
    pet.sequence[
      pet.frameIndex
    ] ||
    pet.sequence[0];

  if (!src) {
    return;
  }

  pet.sprite.src =
    src;

  if (
    !pet.isHost &&
    settings.tintEnabled
  ) {
    const mask =
      `url("${src}")`;

    pet.tintLayer.style.webkitMaskImage =
      mask;

    pet.tintLayer.style.maskImage =
      mask;
  }
}

function advanceFrame(
  pet
) {
  if (
    pet.cancelled ||
    pet.leaving ||
    !pet.sequence.length
  ) {
    return;
  }

  pet.frameIndex =
    (
      pet.frameIndex + 1
    ) %
    pet.sequence.length;

  renderFrame(
    pet
  );
}

function applyVisualDirection(
  pet
) {
  const movingRight =
    pet.direction >= 0;

  const shouldFaceRight =
    settings.baseFramesFaceRight
      ? movingRight
      : !movingRight;

  pet.spriteBox.style.transform =
    shouldFaceRight
      ? "translateX(-50%) scaleX(1)"
      : "translateX(-50%) scaleX(-1)";
}

function setPetState(
  pet,
  state
) {
  if (
    pet.cancelled ||
    pet.leaving
  ) {
    return;
  }

  pet.state =
    state;

  pet.sequence =
    state === "walk"
      ? assets.walk
      : assets.idle;

  pet.frameIndex =
    0;

  pet.frameElapsed =
    0;

  renderFrame(
    pet
  );

  applyVisualDirection(
    pet
  );
}


/* =========================================================
   MOVEMENT
   ========================================================= */

function updatePetMovement(
  pet,
  now
) {
  if (
    pet.cancelled ||
    pet.leaving ||
    !pet.movement
  ) {
    return;
  }

  const movement =
    pet.movement;

  const elapsed =
    now -
    movement.startTime;

  const progress =
    movement.durationMs <= 0
      ? 1
      : Math.min(
          1,
          Math.max(
            0,
            elapsed /
            movement.durationMs
          )
        );

  pet.x =
    movement.startX +
    (
      movement.targetX -
      movement.startX
    ) *
    progress;

  pet.element.style.left =
    `${pet.x}px`;

  if (
    progress >= 1
  ) {
    pet.x =
      movement.targetX;

    pet.element.style.left =
      `${pet.x}px`;

    pet.movement =
      null;

    pet.element.classList.remove(
      "moving"
    );

    const resolve =
      movement.resolve;

    if (
      typeof resolve ===
      "function"
    ) {
      resolve();
    }

    savePetState();
  }
}

function startPetMovement(
  pet,
  target,
  durationMs
) {
  if (
    pet.cancelled ||
    pet.leaving
  ) {
    return Promise.resolve();
  }

  const startX =
    pet.x;

  const endX =
    Number(
      target
    );

  if (
    !Number.isFinite(
      endX
    )
  ) {
    return Promise.resolve();
  }

  if (
    Math.abs(
      endX -
      startX
    ) < 1
  ) {
    pet.x =
      endX;

    pet.element.style.left =
      `${endX}px`;

    return Promise.resolve();
  }

  if (
    pet.movement
  ) {
    const previousResolve =
      pet.movement.resolve;

    pet.movement =
      null;

    if (
      typeof previousResolve ===
      "function"
    ) {
      previousResolve();
    }
  }

  pet.element.classList.remove(
    "moving"
  );

  pet.element.style.transition =
    "none";

  pet.element.style.left =
    `${startX}px`;

  void pet.element.offsetWidth;

  pet.element.classList.add(
    "moving"
  );

  return new Promise(
    (resolve) => {
      pet.movement = {
        startX,

        targetX:
          endX,

        startTime:
          performance.now(),

        durationMs:
          Math.max(
            0,
            Number(
              durationMs
            ) ||
            0
          ),

        resolve
      };
    }
  );
}


/* =========================================================
   FRAME + MOVEMENT TICKER
   ========================================================= */

function startFrameTicker() {
  if (
    frameTicker
  ) {
    cancelAnimationFrame(
      frameTicker
    );
  }

  let lastTime =
    performance.now();

  function tick(
    now
  ) {
    const delta =
      Math.min(
        250,
        Math.max(
          0,
          now -
          lastTime
        )
      );

    lastTime =
      now;

    if (
      initialized
    ) {
      for (
        const pet of pets
      ) {
        if (
          pet.cancelled ||
          pet.leaving
        ) {
          continue;
        }

        updatePetMovement(
          pet,
          now
        );

        if (
          !pet.sequence.length
        ) {
          continue;
        }

        pet.frameElapsed +=
          delta;

        while (
          pet.frameElapsed >=
          settings.frameMs
        ) {
          pet.frameElapsed -=
            settings.frameMs;

          advanceFrame(
            pet
          );
        }
      }
    }

    frameTicker =
      requestAnimationFrame(
        tick
      );
  }

  frameTicker =
    requestAnimationFrame(
      tick
    );
}


/* =========================================================
   DURATIONS
   ========================================================= */

function durationSnappedToCycles(
  minSec,
  maxSec,
  sequenceLength
) {
  const cycleMs =
    Math.max(
      1,
      sequenceLength *
      settings.frameMs
    );

  const minMs =
    Math.max(
      cycleMs,
      minSec * 1000
    );

  const maxMs =
    Math.max(
      minMs,
      maxSec * 1000
    );

  const randomMs =
    minMs +
    Math.random() *
    Math.max(
      0,
      maxMs -
      minMs
    );

  const cycles =
    Math.max(
      1,
      Math.round(
        randomMs /
        cycleMs
      )
    );

  return (
    cycles *
    cycleMs
  );
}

function getCycleDurationMs(
  state
) {
  const sequence =
    state === "walk"
      ? assets.walk
      : assets.idle;

  if (
    !sequence.length
  ) {
    return settings.frameMs;
  }

  return state === "walk"
    ? durationSnappedToCycles(
        settings.walkMinSec,
        settings.walkMaxSec,
        sequence.length
      )
    : durationSnappedToCycles(
        settings.idleMinSec,
        settings.idleMaxSec,
        sequence.length
      );
}


/* =========================================================
   MOVEMENT BOUNDS
   ========================================================= */

function getHorizontalBounds() {
  const width =
    stage.clientWidth ||
    window.innerWidth ||
    1920;

  const margin =
    width *
    (
      settings.screenMarginPercent /
      100
    );

  const spriteSize =
    settings.petSize *
    settings.spriteScale;

  const halfPet =
    spriteSize /
    2;

  const minX =
    Math.max(
      halfPet +
      margin,
      0
    );

  const maxX =
    Math.max(
      minX,
      width -
      halfPet -
      margin
    );

  return {
    minX,
    maxX,
    width
  };
}

function chooseWalkTarget(
  pet
) {
  const {
    minX,
    maxX,
    width
  } =
    getHorizontalBounds();

  const range =
    Math.max(
      1,
      maxX -
      minX
    );

  const minDistance =
    Math.min(
      range,
      range *
      settings.minWalkDistancePercent /
      100
    );

  const maxDistance =
    Math.min(
      range,
      range *
      settings.maxWalkDistancePercent /
      100
    );

  const distance =
    minDistance +
    Math.random() *
    Math.max(
      0,
      maxDistance -
      minDistance
    );

  const current =
    Math.min(
      maxX,
      Math.max(
        minX,
        pet.x
      )
    );

  let target;

  if (
    current <=
    minX + 1
  ) {
    target =
      Math.min(
        maxX,
        current +
        distance
      );
  } else if (
    current >=
    maxX - 1
  ) {
    target =
      Math.max(
        minX,
        current -
        distance
      );
  } else {
    const goRight =
      Math.random() >=
      0.5;

    target =
      goRight
        ? current +
          distance
        : current -
          distance;

    target =
      Math.min(
        maxX,
        Math.max(
          minX,
          target
        )
      );
  }

  if (
    Math.abs(
      target -
      current
    ) < 1 &&
    range > 1
  ) {
    target =
      current <
      width / 2
        ? maxX
        : minX;
  }

  return target;
}


/* =========================================================
   SLEEP
   ========================================================= */

function sleepFor(
  pet,
  milliseconds,
  timerKey = "behaviorTimer"
) {
  return new Promise(
    (resolve) => {
      if (
        pet.cancelled ||
        pet.leaving
      ) {
        resolve();

        return;
      }

      if (
        pet[timerKey]
      ) {
        clearTimeout(
          pet[timerKey]
        );

        pet[timerKey] =
          null;
      }

      pet[timerKey] =
        setTimeout(
          () => {
            pet[timerKey] =
              null;

            resolve();
          },
          Math.max(
            0,
            milliseconds
          )
        );
    }
  );
}


/* =========================================================
   IDLE
   ========================================================= */

async function runIdlePhase(
  pet
) {
  if (
    pet.cancelled ||
    pet.leaving ||
    !assets.idle.length
  ) {
    return;
  }

  setPetState(
    pet,
    "idle"
  );

  await sleepFor(
    pet,
    getCycleDurationMs(
      "idle"
    ),
    "behaviorTimer"
  );
}


/* =========================================================
   WALK
   ========================================================= */

async function runWalkPhase(
  pet
) {
  if (
    pet.cancelled ||
    pet.leaving ||
    !assets.walk.length
  ) {
    return;
  }

  const target =
    chooseWalkTarget(
      pet
    );

  if (
    Math.abs(
      target -
      pet.x
    ) < 1
  ) {
    setPetState(
      pet,
      "walk"
    );

    await sleepFor(
      pet,
      getCycleDurationMs(
        "walk"
      ),
      "behaviorTimer"
    );

    return;
  }

  const durationMs =
    getCycleDurationMs(
      "walk"
    );

  pet.direction =
    target >= pet.x
      ? 1
      : -1;

  setPetState(
    pet,
    "walk"
  );

  applyVisualDirection(
    pet
  );

  if (
    pet.cancelled ||
    pet.leaving
  ) {
    return;
  }

  await startPetMovement(
    pet,
    target,
    durationMs
  );

  if (
    pet.cancelled ||
    pet.leaving
  ) {
    return;
  }

  pet.x =
    target;

  pet.element.style.left =
    `${target}px`;

  pet.element.style.transition =
    "none";

  pet.element.classList.remove(
    "moving"
  );

  savePetState();
}


/* =========================================================
   PET BEHAVIOUR
   ========================================================= */

async function runPetBehavior(
  pet
) {
  if (
    pet.behaviorPromise
  ) {
    return pet.behaviorPromise;
  }

  pet.behaviorPromise =
    (async () => {
      while (
        !pet.cancelled &&
        !pet.leaving
      ) {
        if (
          assets.idle.length
        ) {
          await runIdlePhase(
            pet
          );
        }

        if (
          pet.cancelled ||
          pet.leaving
        ) {
          break;
        }

        if (
          assets.walk.length
        ) {
          await runWalkPhase(
            pet
          );
        } else {
          await sleepFor(
            pet,
            settings.frameMs * 2,
            "behaviorTimer"
          );
        }
      }
    })().catch(
      (error) => {
        console.error(
          "Chat Pets // behaviour error:",
          error
        );
      }
    );

  return pet.behaviorPromise;
}


/* =========================================================
   BUBBLE
   ========================================================= */

function calculateBubbleWidth(
  text
) {
  const maxWidth =
    Math.min(
      settings.bubbleMaxWidth,
      Math.max(
        140,
        (
          stage.clientWidth ||
          window.innerWidth
        ) * 0.32
      )
    );

  const canvas =
    calculateBubbleWidth.canvas ||
    (
      calculateBubbleWidth.canvas =
        document.createElement(
          "canvas"
        )
    );

  const ctx =
    canvas.getContext(
      "2d"
    );

  if (!ctx) {
    return 220;
  }

  ctx.font =
    `
      ${settings.bubbleFontMax}px
      '${settings.pixelFont}',
      monospace
    `;

  const fullWidth =
    ctx.measureText(
      text
    ).width +
    36;

  if (
    fullWidth <=
    maxWidth
  ) {
    return Math.max(
      70,
      fullWidth
    );
  }

  const words =
    text.split(" ");

  let line = "";
  let widest = 0;

  for (
    const word of words
  ) {
    const candidate =
      line
        ? `${line} ${word}`
        : word;

    const candidateWidth =
      ctx.measureText(
        candidate
      ).width;

    if (
      candidateWidth >
        maxWidth - 36 &&
      line
    ) {
      widest =
        Math.max(
          widest,
          ctx.measureText(
            line
          ).width
        );

      line =
        word;
    } else {
      line =
        candidate;
    }
  }

  widest =
    Math.max(
      widest,
      ctx.measureText(
        line
      ).width
    );

  return Math.max(
    70,
    Math.min(
      maxWidth,
      widest + 36
    )
  );
}

function showBubble(
  pet,
  rawText,
  durationSec
) {
  if (
    !pet ||
    pet.cancelled ||
    pet.leaving
  ) {
    return;
  }

  const text =
    sanitizeMessage(
      rawText
    );

  if (!text) {
    return;
  }

  if (
    pet.bubbleTimer
  ) {
    clearTimeout(
      pet.bubbleTimer
    );
  }

  const ratio =
    Math.min(
      1,
      text.length /
      Math.max(
        20,
        settings.maxMessageCharacters
      )
    );

  const fontSize =
    Math.round(
      settings.bubbleFontMax -
      (
        settings.bubbleFontMax -
        settings.bubbleFontMin
      ) *
      ratio
    );

  pet.bubbleText.textContent =
    text;

  pet.bubbleText.style.fontSize =
    `${fontSize}px`;

  pet.bubble.style.width =
    `${calculateBubbleWidth(text)}px`;

  pet.bubble.classList.add(
    "visible"
  );

  pet.bubbleTimer =
    setTimeout(
      () => {
        pet.bubble.classList.remove(
          "visible"
        );

        pet.bubbleTimer =
          null;
      },
      Math.max(
        0.5,
        durationSec
      ) * 1000
    );
}


/* =========================================================
   PERSISTENCE
   ========================================================= */

function stableSerialize(
  value
) {
  if (
    value === null ||
    value === undefined
  ) {
    return String(
      value
    );
  }

  if (
    Array.isArray(
      value
    )
  ) {
    return (
      "[" +
      value
        .map(
          (entry) =>
            stableSerialize(
              entry
            )
        )
        .join(",") +
      "]"
    );
  }

  if (
    typeof value === "object"
  ) {
    return (
      "{" +
      Object.keys(
        value
      )
        .sort()
        .map(
          (key) =>
            JSON.stringify(
              key
            ) +
            ":" +
            stableSerialize(
              value[key]
            )
        )
        .join(",") +
      "}"
    );
  }

  return JSON.stringify(
    value
  );
}

function getConfigSignature(
  data
) {
  return stableSerialize(
    data || {}
  );
}

function getStorageKey() {
  const channel =
    channelUsername ||
    "unknown";

  return (
    "chat-pets-state-v2:" +
    channel
  );
}

function getCurrentPetX(
  pet
) {
  if (
    !pet ||
    !pet.element
  ) {
    return pet?.x || 0;
  }

  if (
    pet.movement
  ) {
    return pet.x;
  }

  const rect =
    pet.element.getBoundingClientRect();

  const stageRect =
    stage.getBoundingClientRect();

  return (
    rect.left -
    stageRect.left +
    rect.width / 2
  );
}

function captureCurrentPetState() {
  return pets
    .filter(
      (pet) =>
        !pet.cancelled &&
        !pet.leaving
    )
    .map(
      (pet) => ({
        isHost:
          pet.isHost,

        userId:
          pet.userId,

        username:
          pet.username,

        nameColor:
          pet.nameColor,

        tintIndex:
          pet.tintIndex,

        x:
          getCurrentPetX(
            pet
          ),

        direction:
          pet.direction
      })
    );
}

function savePetState() {
  if (
    restoringState
  ) {
    return;
  }

  try {
    const state = {
      version:
        2,

      configSignature:
        activeConfigSignature ||
        getConfigSignature(
          fieldData
        ),

      hostEnabled:
        settings.hostEnabled,

      pets:
        captureCurrentPetState()
    };

    const serialized =
      JSON.stringify(
        state
      );

    try {
      localStorage.setItem(
        getStorageKey(),
        serialized
      );
    } catch (_) {
      try {
        sessionStorage.setItem(
          getStorageKey(),
          serialized
        );
      } catch (__) {
        // ignore storage failure
      }
    }
  } catch (error) {
    console.warn(
      "Chat Pets // state save failed:",
      error
    );
  }
}

function clearSavedPetState() {
  try {
    localStorage.removeItem(
      getStorageKey()
    );
  } catch (_) {
    // ignore
  }

  try {
    sessionStorage.removeItem(
      getStorageKey()
    );
  } catch (_) {
    // ignore
  }

  try {
    sessionStorage.removeItem(
      "chat-pets-state-v1:" +
      (
        channelUsername ||
        "unknown"
      )
    );
  } catch (_) {
    // ignore
  }
}

function loadSavedPetState() {
  let raw =
    null;

  try {
    raw =
      localStorage.getItem(
        getStorageKey()
      );
  } catch (_) {
    // fallback below
  }

  if (!raw) {
    try {
      raw =
        sessionStorage.getItem(
          getStorageKey()
        );
    } catch (_) {
      raw =
        null;
    }
  }

  /*
   * Backward compatibility.
   */
  if (!raw) {
    try {
      const oldRaw =
        sessionStorage.getItem(
          "chat-pets-state-v1:" +
          (
            channelUsername ||
            "unknown"
          )
        );

      if (oldRaw) {
        const oldState =
          JSON.parse(
            oldRaw
          );

        if (
          oldState &&
          Array.isArray(
            oldState.pets
          )
        ) {
          return {
            version:
              1,

            configSignature:
              null,

            hostEnabled:
              oldState.pets.some(
                (pet) =>
                  pet.isHost
              ),

            pets:
              oldState.pets
          };
        }
      }
    } catch (_) {
      // ignore
    }

    return null;
  }

  try {
    const parsed =
      JSON.parse(
        raw
      );

    if (
      !parsed ||
      !Array.isArray(
        parsed.pets
      )
    ) {
      return null;
    }

    return {
      version:
        parsed.version || 2,

      configSignature:
        parsed.configSignature ||
        null,

      hostEnabled:
        parsed.hostEnabled !== false,

      pets:
        parsed.pets
    };
  } catch (error) {
    console.warn(
      "Chat Pets // state load failed:",
      error
    );

    return null;
  }
}

function startPersistence() {
  if (
    persistenceTimer
  ) {
    clearInterval(
      persistenceTimer
    );
  }

  persistenceTimer =
    setInterval(
      savePetState,
      1000
    );
}


/* =========================================================
   REMOVE / LIMIT
   ========================================================= */

function clearPetTimers(
  pet
) {
  if (
    pet.behaviorTimer
  ) {
    clearTimeout(
      pet.behaviorTimer
    );

    pet.behaviorTimer =
      null;
  }

  if (
    pet.hostSpeechTimer
  ) {
    clearTimeout(
      pet.hostSpeechTimer
    );

    pet.hostSpeechTimer =
      null;
  }

  if (
    pet.bubbleTimer
  ) {
    clearTimeout(
      pet.bubbleTimer
    );

    pet.bubbleTimer =
      null;
  }

  if (
    pet.movement
  ) {
    const resolve =
      pet.movement.resolve;

    pet.movement =
      null;

    if (
      typeof resolve ===
      "function"
    ) {
      resolve();
    }
  }
}

function removePet(
  pet
) {
  if (
    !pet ||
    pet.cancelled
  ) {
    return;
  }

  pet.cancelled =
    true;

  clearPetTimers(
    pet
  );

  pet.element.classList.remove(
    "moving"
  );

  pet.element.classList.remove(
    "entering"
  );

  pet.element.classList.remove(
    "leaving"
  );

  pet.element.style.transition =
    "none";

  pet.element.remove();

  pets =
    pets.filter(
      (entry) =>
        entry !== pet
    );

  if (
    !pet.isHost &&
    pet.userId
  ) {
    userPets.delete(
      pet.userId
    );

    petOrder =
      petOrder.filter(
        (id) =>
          id !== pet.userId
      );

    releaseTintForUser(
      pet.userId
    );
  }

  updatePetDepth();

  savePetState();
}

function playLeaveAnimation(
  pet
) {
  if (
    !pet ||
    pet.cancelled ||
    pet.leaving
  ) {
    return;
  }

  pet.leaving =
    true;

  clearPetTimers(
    pet
  );

  pet.element.classList.remove(
    "entering"
  );

  pet.element.classList.remove(
    "moving"
  );

  pet.element.style.transition =
    "none";

  if (
    !settings.entryEffect ||
    settings.entryDurationMs <= 0
  ) {
    removePet(
      pet
    );

    return;
  }

  pet.element.style.setProperty(
    "--entry-duration",
    `${settings.entryDurationMs}ms`
  );

  pet.element.classList.add(
    "leaving"
  );

  setTimeout(
    () => {
      if (
        !pet.cancelled
      ) {
        removePet(
          pet
        );
      }
    },
    settings.entryDurationMs
  );
}

function updatePetDepth() {
  for (
    const pet of pets
  ) {
    if (
      pet.cancelled
    ) {
      continue;
    }

    if (
      pet.isHost
    ) {
      pet.element.style.zIndex =
        "1000";

      continue;
    }

    const index =
      petOrder.indexOf(
        pet.userId
      );

    pet.element.style.zIndex =
      String(
        10 +
        Math.max(
          0,
          index
        )
      );
  }
}

function enforcePetLimit() {
  while (
    petOrder.length >
    settings.maxPets
  ) {
    const oldestUserId =
      petOrder.shift();

    if (!oldestUserId) {
      break;
    }

    const oldestPet =
      userPets.get(
        oldestUserId
      );

    if (
      oldestPet
    ) {
      removePet(
        oldestPet
      );
    }
  }
}


/* =========================================================
   HOST
   ========================================================= */

function createHostPet() {
  if (
    !settings.hostEnabled
  ) {
    return null;
  }

  const existing =
    pets.find(
      (pet) =>
        pet.isHost &&
        !pet.cancelled &&
        !pet.leaving
    );

  if (
    existing
  ) {
    return existing;
  }

  const {
    width
  } =
    getHorizontalBounds();

  return spawnPet({
    isHost:
      true,

    userId:
      "__host__",

    username:
      settings.hostName,

    nameColor:
      settings.hostNameColor,

    x:
      width / 2
  });
}

async function runHostSpeechLoop(
  host
) {
  if (
    !host ||
    host.cancelled ||
    host.leaving ||
    !settings.hostLines.length
  ) {
    return;
  }

  host.hostSpeechPromise =
    (async () => {
      while (
        !host.cancelled &&
        !host.leaving
      ) {
        const minMs =
          settings.hostSpeechMinSec *
          1000;

        const maxMs =
          Math.max(
            minMs,
            settings.hostSpeechMaxSec *
            1000
          );

        const delay =
          minMs +
          Math.random() *
          (
            maxMs -
            minMs
          );

        await sleepFor(
          host,
          delay,
          "hostSpeechTimer"
        );

        if (
          host.cancelled ||
          host.leaving
        ) {
          break;
        }

        if (
          !settings.hostLines.length
        ) {
          continue;
        }

        const line =
          settings.hostLines[
            Math.floor(
              Math.random() *
              settings.hostLines.length
            )
          ];

        if (
          settings.showMessageBubble
        ) {
          showBubble(
            host,
            line,
            settings.hostBubbleDurationSec
          );
        }
      }
    })().catch(
      (error) => {
        console.error(
          "Chat Pets // host speech error:",
          error
        );
      }
    );
}


/* =========================================================
   SPAWN
   ========================================================= */

function spawnPet({
  isHost = false,
  userId = null,
  username = "Viewer",
  nameColor = null,
  firstMessage = "",
  x = null,
  direction = null,
  tintIndex = null,
  restored = false,
  startBehavior = true
}) {
  let tintColor =
    "#FFFFFF";

  let resolvedTintIndex =
    null;

  if (
    !isHost
  ) {
    const tint =
      pickTintForUser(
        userId ||
        username,
        tintIndex
      );

    tintColor =
      tint.color;

    resolvedTintIndex =
      tint.index;
  }

  const pet =
    createPetRecord({
      isHost,

      userId,

      username:
        isHost
          ? settings.hostName
          : username,

      nameColor:
        isHost
          ? settings.hostNameColor
          : (
              nameColor ||
              settings.nameColor
            ),

      tintColor,

      tintIndex:
        resolvedTintIndex
    });

  pet.sequence =
    assets.idle.length
      ? assets.idle
      : assets.walk;

  pet.frameIndex =
    0;

  pet.frameElapsed =
    0;

  renderFrame(
    pet
  );

  const {
    minX,
    maxX,
    width
  } =
    getHorizontalBounds();

  if (
    x === null ||
    !Number.isFinite(
      Number(x)
    )
  ) {
    pet.x =
      isHost
        ? width / 2
        : (
            minX +
            Math.random() *
            Math.max(
              0,
              maxX -
              minX
            )
          );
  } else {
    pet.x =
      Math.min(
        maxX,
        Math.max(
          minX,
          Number(x)
        )
      );
  }

  pet.element.style.left =
    `${pet.x}px`;

  pet.element.style.bottom =
    `${settings.groundOffset}px`;

  pet.direction =
    direction === 1 ||
    direction === -1
      ? direction
      : (
          Math.random() >=
          0.5
            ? 1
            : -1
        );

  applyVisualDirection(
    pet
  );

  pets.push(
    pet
  );

  updatePetDepth();

  /*
   * Only new pets receive the entry animation.
   */
  if (
    settings.entryEffect &&
    !restored &&
    settings.entryDurationMs > 0
  ) {
    pet.element.classList.add(
      "entering"
    );

    setTimeout(
      () => {
        if (
          !pet.cancelled &&
          !pet.leaving
        ) {
          pet.element.classList.remove(
            "entering"
          );
        }
      },
      settings.entryDurationMs
    );
  }

  if (
    isHost
  ) {
    if (
      startBehavior
    ) {
      runPetBehavior(
        pet
      );
    }

    return pet;
  }

  if (
    userId
  ) {
    userPets.set(
      userId,
      pet
    );

    petOrder.push(
      userId
    );

    enforcePetLimit();

    if (
      !restored &&
      settings.showMessageBubble &&
      firstMessage
    ) {
      showBubble(
        pet,
        firstMessage,
        settings.messageDurationSec
      );
    }

    if (
      startBehavior
    ) {
      runPetBehavior(
        pet
      );
    }
  }

  if (
    !restoringState
  ) {
    savePetState();
  }

  return pet;
}


/* =========================================================
   RESTORE
   ========================================================= */

function restorePetsFromState(
  savedPets,
  previousHostEnabled,
  hostShouldLeave = false
) {
  if (
    !Array.isArray(
      savedPets
    ) ||
    !savedPets.length
  ) {
    return false;
  }

  restoringState =
    true;

  let restoredAnything =
    false;

  try {
    const savedHost =
      savedPets.find(
        (entry) =>
          entry.isHost
      );

    /*
     * Host remains enabled:
     * restore current Host settings at
     * the saved position.
     */
    if (
      settings.hostEnabled &&
      savedHost
    ) {
      spawnPet({
        isHost:
          true,

        userId:
          "__host__",

        username:
          settings.hostName,

        nameColor:
          settings.hostNameColor,

        x:
          savedHost.x,

        direction:
          savedHost.direction,

        restored:
          true,

        startBehavior:
          true
      });

      restoredAnything =
        true;
    }

    /*
     * Host was disabled:
     * recreate it temporarily only to
     * play the leave animation.
     */
    if (
      !settings.hostEnabled &&
      previousHostEnabled &&
      hostShouldLeave &&
      savedHost
    ) {
      const leavingHost =
        spawnPet({
          isHost:
            true,

          userId:
            "__host__",

          username:
            savedHost.username ||
            "HOST",

          nameColor:
            savedHost.nameColor ||
            settings.nameColor,

          x:
            savedHost.x,

          direction:
            savedHost.direction,

          restored:
            true,

          startBehavior:
            false
        });

      playLeaveAnimation(
        leavingHost
      );

      restoredAnything =
        true;
    }

    /*
     * Restore viewer pets with their
     * previous positions and tint indices.
     */
    for (
      const entry of savedPets
    ) {
      if (
        entry.isHost
      ) {
        continue;
      }

      if (
        !entry.userId
      ) {
        continue;
      }

      spawnPet({
        isHost:
          false,

        userId:
          entry.userId,

        username:
          entry.username ||
          "Viewer",

        nameColor:
          entry.nameColor ||
          settings.nameColor,

        tintIndex:
          Number.isInteger(
            entry.tintIndex
          )
            ? entry.tintIndex
            : null,

        x:
          entry.x,

        direction:
          entry.direction,

        restored:
          true,

        startBehavior:
          true
      });

      restoredAnything =
        true;

      if (
        petOrder.length >=
        settings.maxPets
      ) {
        break;
      }
    }
  } finally {
    restoringState =
      false;
  }

  return restoredAnything;
}

function restoreSavedPets(
  configChanged = false
) {
  const saved =
    loadSavedPetState();

  if (
    !saved ||
    !saved.pets ||
    !saved.pets.length
  ) {
    return false;
  }

  /*
   * Reset Pets on Refresh is ignored when
   * the configuration itself changed.
   *
   * That is a settings update, not a
   * true refresh.
   */
  if (
    settings.resetOnRefresh &&
    !configChanged
  ) {
    return false;
  }

  const previousHostEnabled =
    saved.hostEnabled !== false;

  return restorePetsFromState(
    saved.pets,
    previousHostEnabled,
    configChanged
  );
}


/* =========================================================
   CHAT
   ========================================================= */

function extractChatMessage(
  obj
) {
  const data =
    obj?.detail?.event?.data ||
    obj?.detail?.event ||
    obj?.data ||
    obj ||
    {};

  const messageData =
    data?.data ||
    data;

  const userId =
    asString(
      messageData.userId ??
      messageData.userID ??
      messageData.uid ??
      messageData.tags?.userId,
      ""
    ).trim();

  const displayName =
    asString(
      messageData.displayName ??
      messageData.username ??
      messageData.name ??
      messageData.nick,
      "Viewer"
    ).trim();

  const text =
    asString(
      messageData.text ??
      messageData.message ??
      messageData.displayMessage ??
      messageData.messageData?.text ??
      messageData.snippet?.displayMessage,
      ""
    );

  const color =
    asString(
      messageData.displayColor ??
      messageData.displayColour ??
      messageData.tags?.color ??
      messageData.color,
      ""
    ).trim();

  return {
    userId:
      userId ||
      `name:${displayName.toLowerCase()}`,

    displayName:
      displayName ||
      "Viewer",

    text,

    color
  };
}

function handleChatMessage(
  obj
) {
  const message =
    extractChatMessage(
      obj
    );

  const normalizedName =
    message.displayName
      .toLowerCase();

  if (
    settings.ignoreStreamer &&
    channelUsername &&
    normalizedName ===
      channelUsername.toLowerCase()
  ) {
    return;
  }

  const text =
    sanitizeMessage(
      message.text
    );

  if (!text) {
    return;
  }

  const existingPet =
    userPets.get(
      message.userId
    );

  if (
    existingPet &&
    !existingPet.cancelled &&
    !existingPet.leaving
  ) {
    if (
      settings.showMessageBubble
    ) {
      showBubble(
        existingPet,
        text,
        settings.messageDurationSec
      );
    }

    savePetState();

    return;
  }

  const twitchColor =
    settings.useTwitchNameColor &&
    /^#[0-9a-f]{6}$/i.test(
      message.color
    )
      ? message.color
      : settings.nameColor;

  spawnPet({
    isHost:
      false,

    userId:
      message.userId,

    username:
      message.displayName,

    nameColor:
      twitchColor,

    firstMessage:
      text
  });
}


/* =========================================================
   PRELOAD
   ========================================================= */

function preloadImage(
  url
) {
  return new Promise(
    (resolve) => {
      const img =
        new Image();

      let finished =
        false;

      function finish(
        value
      ) {
        if (
          finished
        ) {
          return;
        }

        finished =
          true;

        resolve(
          value
        );
      }

      img.onload =
        () =>
          finish(url);

      img.onerror =
        () =>
          finish(null);

      setTimeout(
        () =>
          finish(null),
        10000
      );

      img.src =
        url;
    }
  );
}

async function preloadAssets() {
  const idleUnique =
    [
      ...new Set(
        settings.idleFrames
      )
    ];

  const walkUnique =
    [
      ...new Set(
        settings.walkFrames
      )
    ];

  const [
    idleLoaded,
    walkLoaded
  ] =
    await Promise.all([
      Promise.all(
        idleUnique.map(
          preloadImage
        )
      ),

      Promise.all(
        walkUnique.map(
          preloadImage
        )
      )
    ]);

  const idle =
    idleLoaded.filter(
      Boolean
    );

  const walk =
    walkLoaded.filter(
      Boolean
    );

  assets = {
    idle:
      buildPingPong(
        idle
      ),

    walk
  };

  console.log(
    "Chat Pets // assets loaded",
    {
      idleFrames:
        assets.idle.length,

      walkFrames:
        assets.walk.length
    }
  );
}


/* =========================================================
   INITIALIZE
   ========================================================= */

async function initializeWidget(
  obj
) {
  const isLiveReinitialize =
    pets.length > 0;

  const preservedState =
    isLiveReinitialize
      ? captureCurrentPetState()
      : null;

  const previousHostEnabled =
    isLiveReinitialize
      ? Boolean(
          settings.hostEnabled
        )
      : null;

  fieldData =
    obj?.detail?.fieldData ||
    {};

  channelUsername =
    asString(
      obj?.detail?.channel?.username,
      ""
    ).trim();

  if (
    persistenceTimer
  ) {
    clearInterval(
      persistenceTimer
    );

    persistenceTimer =
      0;
  }

  parseSettings(
    fieldData
  );

  activeConfigSignature =
    getConfigSignature(
      fieldData
    );

  /*
   * When the iframe was recreated by OBS /
   * StreamElements, pets[] is empty.
   *
   * The saved configuration signature lets
   * us tell a settings change apart from a
   * normal refresh.
   */
  const savedState =
    isLiveReinitialize
      ? null
      : loadSavedPetState();

  const savedConfigChanged =
    Boolean(
      savedState &&
      savedState.configSignature &&
      savedState.configSignature !==
        activeConfigSignature
    );

  /*
   * Actual refresh + Reset ON + same config:
   * wipe the stored state.
   */
  if (
    !isLiveReinitialize &&
    settings.resetOnRefresh &&
    !savedConfigChanged
  ) {
    clearSavedPetState();
  }

  /*
   * Prevent cleanup from overwriting the
   * persistent state with an empty list.
   */
  restoringState =
    true;

  try {
    for (
      const pet of [
        ...pets
      ]
    ) {
      removePet(
        pet
      );
    }
  } finally {
    restoringState =
      false;
  }

  pets = [];

  userPets =
    new Map();

  petOrder = [];

  tintAssignments =
    new Map();

  nextPetId = 1;

  assets = {
    idle: [],
    walk: []
  };

  initialized =
    false;

  await preloadAssets();

  if (
    !assets.walk.length
  ) {
    console.warn(
      "Chat Pets // no walk frames loaded. Viewer/host pets will remain IDLE."
    );
  }

  if (
    !assets.idle.length
  ) {
    console.warn(
      "Chat Pets // no idle frames loaded."
    );
  }

  initialized =
    true;

  startFrameTicker();

  let restored =
    false;

  /*
   * =======================================================
   * LIVE REINITIALIZATION
   * =======================================================
   *
   * This covers a settings update where
   * the old DOM still exists.
   */
  if (
    isLiveReinitialize &&
    preservedState &&
    preservedState.length
  ) {
    const hostWasEnabled =
      previousHostEnabled === true;

    const hostShouldLeave =
      hostWasEnabled &&
      !settings.hostEnabled;

    restored =
      restorePetsFromState(
        preservedState,
        hostWasEnabled,
        hostShouldLeave
      );
  }

  /*
   * =======================================================
   * FRESH / RECREATED WIDGET
   * =======================================================
   *
   * Covers:
   * - OBS refreshing the source
   * - StreamElements recreating the iframe
   * - actual page reloads
   *
   * A changed config means we restore.
   */
  if (
    !isLiveReinitialize
  ) {
    restored =
      restoreSavedPets(
        savedConfigChanged
      );
  }

  /*
   * If no Host was restored and the Host
   * setting is enabled, create a new one.
   */
  if (
    !restored &&
    settings.hostEnabled
  ) {
    createHostPet();
  }

  const host =
    pets.find(
      (pet) =>
        pet.isHost &&
        !pet.cancelled &&
        !pet.leaving
    );

  if (
    host
  ) {
    runHostSpeechLoop(
      host
    );
  }

  startPersistence();

  savePetState();

  console.log(
    "Chat Pets // initialized",
    {
      liveReinitialize:
        isLiveReinitialize,

      resetOnRefresh:
        settings.resetOnRefresh,

      savedConfigChanged,

      restored,

      viewerPets:
        userPets.size,

      hostEnabled:
        settings.hostEnabled,

      tintEnabled:
        settings.tintEnabled
    }
  );
}


/* =========================================================
   EVENTS
   ========================================================= */

window.addEventListener(
  "onWidgetLoad",
  initializeWidget
);

window.addEventListener(
  "onEventReceived",
  function (obj) {
    if (
      obj?.detail?.listener ===
      "message"
    ) {
      handleChatMessage(
        obj
      );
    }
  }
);


/* =========================================================
   RESIZE
   ========================================================= */

window.addEventListener(
  "resize",
  function () {
    const {
      minX,
      maxX
    } =
      getHorizontalBounds();

    for (
      const pet of pets
    ) {
      if (
        pet.cancelled ||
        pet.leaving ||
        pet.movement
      ) {
        continue;
      }

      pet.x =
        Math.min(
          maxX,
          Math.max(
            minX,
            pet.x
          )
        );

      pet.element.style.left =
        `${pet.x}px`;
    }

    savePetState();
  }
);


/* =========================================================
   EXIT
   ========================================================= */

window.addEventListener(
  "beforeunload",
  savePetState
);

document.addEventListener(
  "visibilitychange",
  function () {
    if (
      document.visibilityState ===
      "hidden"
    ) {
      savePetState();
    }
  }
);
