    document.createElement(
      "div"
    );

  name.className =
    "pet-name";

  name.textContent =
    sanitizeUsername(
      username
    );

  const core =
    document.createElement(
      "div"
    );

  core.className =
    "pet-core";

  const spriteBox =
    document.createElement(
      "div"
