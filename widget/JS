/* =========================================================
   HELPERS
   ========================================================= */

function asNumber(
  value,
  fallback
) {
  const number =
    Number(value);

  return Number.isFinite(
    number
  )
    ? number
    : fallback;
}

function asBoolean(
  value,
  fallback = false
) {
  if (
    typeof value === "boolean"
  ) {
    return value;
  }

  if (
    typeof value === "string"
  ) {
    const normalized =
      value
        .trim()
        .toLowerCase();

    if (
      normalized === "true" ||
      normalized === "1"
    ) {
      return true;
    }

    if (
      normalized === "false" ||
      normalized === "0" ||
      normalized === ""
    ) {
      return false;
    }
  }

  return fallback;
}

function asString(
  value,
  fallback = ""
) {
  if (
    value === null ||
    value === undefined
  ) {
    return fallback;
  }

  return String(value);
}

function normalizeImageList(
  value
) {
  if (
    Array.isArray(value)
  ) {
    return value.filter(
      (url) =>
        typeof url === "string" &&
        url.trim()
    );
  }

  if (
    typeof value !== "string"
  ) {
    return [];
  }

  const trimmed =
    value.trim();

  if (!trimmed) {
    return [];
  }

  try {
    const parsed =
      JSON.parse(
        trimmed
      );

    if (
      Array.isArray(parsed)
    ) {
      return parsed.filter(
        (url) =>
          typeof url === "string" &&
          url.trim()
      );
    }
  } catch (_) {
    // normal fallback
  }

  return trimmed
    .split(
      /\s*,\s*|\n+/
    )
    .map(
      (url) =>
        url.trim()
    )
    .filter(Boolean);
}


