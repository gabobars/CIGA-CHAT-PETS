/* =========================================================
   ANIMATION
   ========================================================= */

function buildPingPong(
  frames
) {
  if (
    !frames.length
  ) {
    return [];
  }

  if (
    frames.length === 1
  ) {
    return [
      frames[0]
    ];
  }

  return [
    ...frames,

    ...frames
      .slice(0, -1)
      .reverse()
  ];
}


/* =========================================================
   TEXT
   ========================================================= */

function sanitizeMessage(
  value
) {
  const raw =
    asString(
      value,
      ""
    )
      .replace(
        /\s+/g,
        " "
      )
      .trim();

  if (!raw) {
    return "";
  }

  return raw.slice(
    0,
    settings.maxMessageCharacters
  );
}

function sanitizeUsername(
  value
) {
  const raw =
    asString(
      value,
      "Viewer"
    )
      .replace(
        /\s+/g,
        " "
      )
      .trim() ||
    "Viewer";

  if (
    raw.length <=
    settings.maxUsernameCharacters
  ) {
    return raw;
  }

  return (
    raw.slice(
      0,
      Math.max(
        1,
        settings.maxUsernameCharacters - 1
      )
    ) +
    "…"
  );
}


/* =========================================================
   NAME READABILITY
   ========================================================= */

function getReadableNameOutline(
  color
) {
  const match =
    /^#?([0-9a-f]{6})$/i.exec(
      color || ""
    );

  if (!match) {
    return settings.nameOutlineColor;
  }

  const value =
    match[1];

  const r =
    parseInt(
      value.slice(0, 2),
      16
    );

  const g =
    parseInt(
      value.slice(2, 4),
      16
    );

  const b =
    parseInt(
      value.slice(4, 6),
      16
    );

  const luminance =
    (
      0.2126 * r +
      0.7152 * g +
      0.0722 * b
    ) / 255;

  return luminance < 0.42
    ? "#FFFFFF"
    : "#000000";
}


/* =========================================================
   HASH
   ========================================================= */

function hashString(
  value
) {
  let hash =
    2166136261;

  const text =
    String(
      value ||
      ""
    );

  for (
    let i = 0;
    i < text.length;
    i++
  ) {
    hash ^=
      text.charCodeAt(i);

    hash =
      Math.imul(
        hash,
        16777619
      );
  }

  return hash >>> 0;
}


/* =========================================================
   TINT
   ========================================================= */

function getTintKeys() {
  return [
    "tint1",
    "tint2",
    "tint3",
    "tint4",
    "tint5",
    "tint6"
  ];
}

function getTintColors() {
  const keys =
    getTintKeys();

  return keys.map(
    (key) =>
      settings[key] ||
      "#FFFFFF"
  );
}

function getTintIndexForUser(
  userId
) {
  const normalizedId =
    String(
      userId ||
      "viewer"
    );

  /*
   * If this viewer already has a tint
   * assignment, keep it.
   */
  if (
    tintAssignments.has(
      normalizedId
    )
  ) {
    return tintAssignments.get(
      normalizedId
    );
  }

  const keys =
    getTintKeys();

  const preferredIndex =
    hashString(
      normalizedId
    ) %
    keys.length;

  const usedIndices =
    new Set(
      tintAssignments.values()
    );

  /*
   * Prefer the deterministic hash result,
   * but avoid colours already used by active
   * viewers whenever possible.
   */
  for (
    let offset = 0;
    offset < keys.length;
    offset++
  ) {
    const index =
      (
        preferredIndex +
        offset
      ) %
      keys.length;

    if (
      !usedIndices.has(
        index
      )
    ) {
      tintAssignments.set(
        normalizedId,
        index
      );

      return index;
    }
  }

  /*
   * More than six active viewers means
   * a tint must be reused.
   */
  tintAssignments.set(
    normalizedId,
    preferredIndex
  );

  return preferredIndex;
}

function reserveTintForUser(
  userId,
  preferredIndex
) {
  const normalizedId =
    String(
      userId ||
      "viewer"
    );

  const keys =
    getTintKeys();

  if (
    tintAssignments.has(
      normalizedId
    )
  ) {
    return tintAssignments.get(
      normalizedId
    );
  }

  const safeIndex =
    Number.isInteger(
      preferredIndex
    ) &&
    preferredIndex >= 0 &&
    preferredIndex <
      keys.length
      ? preferredIndex
      : null;

  const usedIndices =
    new Set(
      tintAssignments.values()
    );

  if (
    safeIndex !== null &&
    !usedIndices.has(
      safeIndex
    )
  ) {
    tintAssignments.set(
      normalizedId,
      safeIndex
    );

    return safeIndex;
  }

  return getTintIndexForUser(
    normalizedId
  );
}

function pickTintForUser(
  userId,
  preferredIndex = null
) {
  const keys =
    getTintKeys();

  const index =
    reserveTintForUser(
      userId,
      preferredIndex
    );

  return {
    color:
      settings[
        keys[index]
      ] ||
      "#FFFFFF",

    index
  };
}

function releaseTintForUser(
  userId
) {
  if (
    !userId
  ) {
    return;
  }

  tintAssignments.delete(
    String(
      userId
    )
  );
}


